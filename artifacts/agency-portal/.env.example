# Frontend (Vite). Copia in .env.local per il dev locale.
#
# NB: la config Supabase del browser (URL + anon key) NON va più qui: il
# frontend la recupera a runtime da /api/public/supabase-config, servita
# dall'API same-origin (imposta SUPABASE_URL / SUPABASE_ANON_KEY nell'api-server).

# Login Supabase: SEMPRE obbligatorio (hardcoded in src/config/auth-mode.ts).
# Non esiste più VITE_AUTH_ENABLED. Il portale è privato: serve una sessione
# Supabase valida (email+password) per ogni pagina.

# Funzioni AI: true per mostrarle. Assente/false = AI nascosta (default).
# VITE_AI_ENABLED=true

# Solo sviluppo locale: dove gira l'api-server (proxy Vite /api → questo host)
# VITE_API_PROXY_TARGET=http://localhost:8080
